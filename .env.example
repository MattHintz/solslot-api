# Solslot API V2. Keep the real file mode 0600 and outside release archives.

# Launch locks. These remain false until the signed ceremony gate passes.
SOLSLOT_NETWORK=testnet11
SOLSLOT_COINSET_BASE_URL=https://testnet11.api.coinset.org
SOLSLOT_RUNTIME_ENVIRONMENT=production
SOLSLOT_API_DOCS_ENABLED=false
SOLSLOT_SECURITY_HEADERS_ENABLED=true
SOLSLOT_HSTS_ENABLED=true
SOLSLOT_MAX_REQUEST_BODY_BYTES=4194304
SOLSLOT_REQUEST_TIMEOUT_SECONDS=30
# Populate from Cloudflare's current published IPv4 and IPv6 source ranges.
# Only peers inside these CIDRs may supply CF-Connecting-IP for rate limits.
#SOLSLOT_TRUSTED_PROXY_CIDRS=<cloudflare-ipv4-cidrs>,<cloudflare-ipv6-cidrs>
SOLSLOT_CHALLENGE_STORE_PATH=./state/challenges_v2.db
SOLSLOT_ALPHA_WRITES_ENABLED=false
SOLSLOT_MINTING_ENABLED=false
SOLSLOT_CEREMONY_MODE_ENABLED=false
# Governed proposal preparation remains visible in the admin desk, but no
# customer SmartDeed redemption can be prepared or submitted until this lock
# and its SGT-governance dependency are explicitly enabled.
SOLSLOT_SGT_ALLOCATIONS_ENABLED=false
SOLSLOT_FUNDED_REDEMPTIONS_ENABLED=false
#SOLSLOT_SGT_COMPANY_TREASURY_PUZZLE_HASH=0x<release-bound-32-byte-hash>
#SOLSLOT_SGT_WUSDC_B_ASSET_ID=0x<release-bound-wUSDC.b-tail-hash>
SOLSLOT_RELEASE_METADATA_PATH=./release.json

# Fresh V2 state. Never point these at an earlier deployment.
SOLSLOT_DEPLOYMENT_MANIFEST_PATH=./state/deployment_manifest_v2.json
SOLSLOT_PUBLIC_ARTIFACT_PATH=./state/public_artifact_v4.json
SOLSLOT_BOOTSTRAP_MANIFEST_PATH=./state/bootstrap_manifest_v2.json
SOLSLOT_GENESIS_DB_PATH=./state/genesis_ceremony_v2.db
SOLSLOT_GENESIS_OUTPUT_DIR=./state/genesis_ceremonies
SOLSLOT_GENESIS_AUDIT_APPROVAL_PATH=./state/genesis_audit_approval_v2.json
SOLSLOT_GENESIS_EVM_DEPLOYMENT_PATH=./state/genesis_evm_deployment_v2.json
SOLSLOT_ADMIN_RECORDS_PATH=./state/admin_records_v2.json
SOLSLOT_VAULT_REGISTRY_PATH=./state/vault_registry_v2.db
SOLSLOT_ADMIN_DB_PATH=./state/admin_desk_v2.db
SOLSLOT_ZKPASSPORT_LEDGER_DB_PATH=./state/zkpassport_v2.db

# Ceremony session. Generate both secrets independently.
#SOLSLOT_ADMIN_TOKEN=
#SOLSLOT_BOOTSTRAP_SESSION_SECRET=
SOLSLOT_BOOTSTRAP_SESSION_TTL_SECONDS=900
SOLSLOT_BOOTSTRAP_COOKIE_SECURE=true

# Guided launch owner claim. Keep separate from SOLSLOT_ADMIN_TOKEN, consume
# once through the URL fragment, then remove it after owner enrollment.
SOLSLOT_LAUNCH_CONTROL_ENABLED=false
SOLSLOT_LAUNCH_GENESIS_REVIEW_CLASS=independent-release-review
SOLSLOT_LAUNCH_RELEASE_TAG=solslot-v2-alpha-rc27.36-20260824
SOLSLOT_LAUNCH_SOURCE_EVIDENCE_PATH=./state/source-freeze-evidence-rc27.36.json
#SOLSLOT_LAUNCH_SOURCE_EVIDENCE_SHA256=
SOLSLOT_LAUNCH_PLAN_TEMPLATE_PATH=./state/plan-input-template-rc27.36.json
SOLSLOT_LAUNCH_SETTLEMENT_REHEARSAL_PATH=./state/settlement-rehearsal-rc27.36.json
#SOLSLOT_LAUNCH_SESSION_SECRET=
#SOLSLOT_LAUNCH_OWNER_CLAIM_TOKEN=

# Recovery-aware Authority V3. These are public evidence paths and endpoints;
# no daily key, recovery phrase, guardian secret, or Google token belongs here.
#SOLSLOT_AUTHORITY_V3_GOVERNANCE_EVIDENCE_PATH=
#SOLSLOT_AUTHORITY_V3_EVM_RPC_URL=
SOLSLOT_AUTHORITY_V3_EVM_MIN_CONFIRMATIONS=12
#SOLSLOT_AUTHORITY_V3_INDEPENDENT_REVIEW_PATH=
#SOLSLOT_AUTHORITY_V3_INDEPENDENT_REVIEW_SHA256=

# Chain-bound interactive administrator sessions.
#SOLSLOT_ADMIN_JWT_SECRET=
SOLSLOT_ADMIN_JWT_TTL_SECONDS=900
SOLSLOT_ADMIN_LOGIN_PER_IP_PER_MINUTE=6
#SOLSLOT_PROTOCOL_ADMIN_AUTHORITY_V2_LAUNCHER_ID=
#SOLSLOT_PROTOCOL_ADMIN_AUTHORITY_V2_MIPS_ROOT_HASH=
#SOLSLOT_PROTOCOL_ADMIN_AUTHORITY_V2_ADMINS_HASH=
#SOLSLOT_PROTOCOL_ADMIN_AUTHORITY_V2_PENDING_OPS_HASH=
SOLSLOT_PROTOCOL_ADMIN_AUTHORITY_V2_VERSION=1

# Signed V2 ceremony coordinates.
#SOLSLOT_POOL_LAUNCHER_ID=
#SOLSLOT_GOVERNANCE_LAUNCHER_ID=
#SOLSLOT_PROTOCOL_CONFIG_LAUNCHER_ID=
SOLSLOT_PROTOCOL_CONFIG_VERSION=1
#SOLSLOT_PROTOCOL_PROPERTY_REGISTRY_LAUNCHER_ID=
#SOLSLOT_VAULT_VERSION_REGISTRY_LAUNCHER_ID=
SOLSLOT_VAULT_VERSION_REGISTRY_VERSION=1

# Vault launcher faucet. Configure exactly one key source.
#SOLSLOT_FAUCET_MASTER_SK_HEX=
#SOLSLOT_FAUCET_SEED_HEX=
#SOLSLOT_FAUCET_MNEMONIC=
SOLSLOT_FAUCET_MAX_SPEND_MOJOS=10000000
SOLSLOT_FAUCET_CONSOLIDATION_ENABLED=false
SOLSLOT_FAUCET_CONSOLIDATION_THRESHOLD=50
SOLSLOT_FAUCET_CONSOLIDATION_INTERVAL_SECONDS=600
SOLSLOT_FAUCET_CONSOLIDATION_FEE=0
SOLSLOT_FAUCET_CONSOLIDATION_MAX_INPUTS=500
# Mempool-aware fees for server-authored protocol bundles. Uses the same
# faucet key as a bounded fee till and requires the local full-node RPC.
SOLSLOT_PROTOCOL_FEE_FUNDING_ENABLED=false
SOLSLOT_PROTOCOL_MEDIUM_FEE_TARGET_SECONDS=300
SOLSLOT_PROTOCOL_MINIMUM_FEE_MOJOS=1
SOLSLOT_PROTOCOL_MAXIMUM_FEE_MOJOS=10000000
SOLSLOT_PROTOCOL_MEMPOOL_TIMEOUT_SECONDS=20
SOLSLOT_PROTOCOL_MEMPOOL_POLL_SECONDS=0.5

# Exact paid-delivery executor. Hosted remote URLs require all three mTLS
# paths; loopback HTTP is accepted for a same-host Key of Solomon service.
#SOLSLOT_PAYMENT_KOS_EXECUTOR_URL=http://127.0.0.1:8081
#SOLSLOT_PAYMENT_KOS_EXECUTOR_PRIVATE_KEY_FILE=/run/secrets/kos-request.key
#SOLSLOT_PAYMENT_KOS_EXECUTOR_PUBLIC_KEY=0x<48-byte-BLS-public-key>
SOLSLOT_PAYMENT_KOS_EXECUTOR_TIMEOUT_SECONDS=30
#SOLSLOT_PAYMENT_KOS_EXECUTOR_MTLS_CA_PATH=/run/secrets/kos-ca.pem
#SOLSLOT_PAYMENT_KOS_EXECUTOR_MTLS_CERT_PATH=/run/secrets/kos-client.pem
#SOLSLOT_PAYMENT_KOS_EXECUTOR_MTLS_KEY_PATH=/run/secrets/kos-client-key.pem

# Mainnet-only customer Sols bridge and governed liquidity execution.
# Testnet11 must leave both feature flags false. A flag cannot activate a
# capability without a checksum-pinned reviewed release evidence file and an
# installed transaction adapter.
SOLSLOT_SOLS_BRIDGE_ENABLED=false
SOLSLOT_SOLS_LIQUIDITY_ENABLED=false
#SOLSLOT_SOLS_BRIDGE_RELEASE_EVIDENCE_PATH=/run/solslot/sols/warp-cat-release.json
#SOLSLOT_SOLS_BRIDGE_RELEASE_EVIDENCE_SHA256=<64-lowercase-hex>
#SOLSLOT_SOLS_LIQUIDITY_RELEASE_EVIDENCE_PATH=/run/solslot/sols/liquidity-release.json
#SOLSLOT_SOLS_LIQUIDITY_RELEASE_EVIDENCE_SHA256=<64-lowercase-hex>

# Registration and owner-auth challenges.
#SOLSLOT_CHALLENGE_SECRET=
#SOLSLOT_VAULT_SESSION_JWT_SECRET=
SOLSLOT_VAULT_SESSION_TTL_SECONDS=900
SOLSLOT_VAULT_SESSION_COOKIE_SECURE=true
SOLSLOT_VAULT_SESSION_COOKIE_PATH=/protocol-api
SOLSLOT_CHALLENGE_TTL_SECONDS=300
SOLSLOT_CHALLENGE_STORE_MAX_PENDING=50000
SOLSLOT_CHALLENGE_PER_IP_PER_MINUTE=60

# Fresh zkPassport V2 bridge and EVM deployment.
SOLSLOT_ZKPASSPORT_VALIDATOR_URLS=["https://10.77.0.10:9443","https://10.77.0.11:9443","https://10.77.0.12:9443"]
SOLSLOT_ZKPASSPORT_VALIDATOR_PUBKEYS=["0x<48-byte-key-0>","0x<48-byte-key-1>","0x<48-byte-key-2>"]
SOLSLOT_ZKPASSPORT_VALIDATOR_THRESHOLD=2
#SOLSLOT_ZKPASSPORT_VALIDATOR_MTLS_CA_PATH=/run/secrets/validator-ca.pem
#SOLSLOT_ZKPASSPORT_VALIDATOR_MTLS_CERT_PATH=/run/secrets/coordinator-cert.pem
#SOLSLOT_ZKPASSPORT_VALIDATOR_MTLS_KEY_PATH=/run/secrets/coordinator-key.pem
#SOLSLOT_ZKPASSPORT_BRIDGE_POLICY_HASH=
SOLSLOT_ZKPASSPORT_BRIDGE_AMOUNT=1
SOLSLOT_ZKPASSPORT_POLICY_VERSION=2
SOLSLOT_ZKPASSPORT_OWNER_CHALLENGE_TTL_SECONDS=300
#SOLSLOT_ZKPASSPORT_RELAYER_PRIVATE_KEY_HEX=
SOLSLOT_ZKPASSPORT_EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SOLSLOT_ZKPASSPORT_EVM_CHAIN_ID=11155111
SOLSLOT_EIP712_CHAIN_ID=11155111
#SOLSLOT_ZKPASSPORT_FORWARDER_ADDRESS=
#SOLSLOT_ZKPASSPORT_VERIFIER_ADAPTER_ADDRESS=
#SOLSLOT_ZKPASSPORT_EMITTER_ADDRESS=
SOLSLOT_ZKPASSPORT_EVM_MIN_CONFIRMATIONS=12

# Unified Base Sepolia CCIP/Warp payment evidence. The non-signing relayer uses
# this credential only to submit verified lifecycle observations.
#SOLSLOT_PAYMENT_OMNICHAIN_ENABLED=false
#SOLSLOT_PAYMENT_OMNICHAIN_SOURCE_SHA=<exact-40-character-omnichain-commit>
#SOLSLOT_PAYMENT_OMNICHAIN_GATEWAY_PROFILE=bse
#SOLSLOT_PAYMENT_OMNICHAIN_GOVERNANCE_EVIDENCE_PATH=/run/solslot/omnichain/governance-v2.json
#SOLSLOT_PAYMENT_OMNICHAIN_PREFLIGHT_EVIDENCE_PATH=/run/solslot/omnichain/preflight-v3.json
#SOLSLOT_PAYMENT_OMNICHAIN_EVIDENCE_PATH=/run/solslot/omnichain/deployment-v3.json
#SOLSLOT_PAYMENT_OMNICHAIN_OWNERSHIP_INTENT_EVIDENCE_PATH=/run/solslot/omnichain/ownership-intent-v2.json
#SOLSLOT_PAYMENT_OMNICHAIN_ACTIVATION_EVIDENCE_PATH=/run/solslot/omnichain/activation-v3.json
#SOLSLOT_PAYMENT_OMNICHAIN_SAMUEL_EVIDENCE_PATH=/run/solslot/omnichain/samuel-coordinates.json
#SOLSLOT_PAYMENT_OMNICHAIN_INGEST_TOKEN=
# One-shot admin UI for scheduling the reviewed Root Safe ownership handoff.
# This remains independent from payment activation and needs no server key.
#SOLSLOT_PAYMENT_OMNICHAIN_OWNERSHIP_ACTIVATION_ENABLED=false
#SOLSLOT_PAYMENT_OMNICHAIN_OWNERSHIP_SAFE_OPERATION_PATH=/run/solslot/omnichain/ownership-safe-operation-v1.json
#SOLSLOT_PAYMENT_OMNICHAIN_OWNERSHIP_SAFE_OPERATION_HASH=0x...
#SOLSLOT_PAYMENT_OMNICHAIN_OWNERSHIP_MIN_CONFIRMATIONS=12
#SOLSLOT_PAYMENT_OMNICHAIN_RPC_URL=https://sepolia.base.org

# Persistent relay budgets and circuit breaker.
SOLSLOT_ZKPASSPORT_RELAY_PER_IP_PER_MINUTE=12
SOLSLOT_ZKPASSPORT_RELAY_PER_OWNER_PER_MINUTE=6
SOLSLOT_ZKPASSPORT_RELAY_PER_VAULT_PER_HOUR=2
SOLSLOT_ZKPASSPORT_RELAY_GLOBAL_GAS_PER_DAY=20000000
SOLSLOT_ZKPASSPORT_RELAY_CIRCUIT_FAILURE_THRESHOLD=5
SOLSLOT_ZKPASSPORT_RELAY_CIRCUIT_COOLDOWN_SECONDS=900

# Server-to-server offer artifact mutation token.
#SOLSLOT_PROTOCOL_ARTIFACT_API_TOKEN=
# Post-genesis Stripe-voucher rehearsal. Port 8793 belongs to Key of Solomon.
# Keep these unset until the sealed rehearsal config and activation evidence exist.
#SOLSLOT_LAUNCH_REHEARSAL_SERVICE_URL=http://127.0.0.1:8794
#SOLSLOT_LAUNCH_REHEARSAL_SERVICE_TOKEN=
#SOLSLOT_LAUNCH_REHEARSAL_CONFIG_HASH=0x...
#SOLSLOT_LAUNCH_REHEARSAL_EVIDENCE_HMAC_SECRET=

# Post-genesis Stripe test-mode settlement. It is not a ceremony-readiness
# requirement and remains disabled until its separate payment-activation gate
# passes. The same quantity-aware delivery worker handles exact governed
# SmartDeed and SGT outputs. Stripe secrets remain in Telonium and the three
# independent validators.
SOLSLOT_STRIPE_SETTLEMENT_ENABLED=false
SOLSLOT_STRIPE_DELIVERY_WORKER_ENABLED=false
SOLSLOT_STRIPE_MODE=test
#SOLSLOT_STRIPE_ACCOUNT_ID=acct_...
SOLSLOT_STRIPE_DELIVERY_DB_PATH=./state/stripe_deliveries_v1.db
SOLSLOT_PAYMENT_PURCHASE_DB_PATH=./state/payment_purchases_v2.db
# Key of Solomon receives only exact coordinator-signed execution envelopes.
#SOLSLOT_PAYMENT_KOS_EXECUTOR_URL=https://127.0.0.1:8444
#SOLSLOT_PAYMENT_KOS_EXECUTOR_PRIVATE_KEY_FILE=/run/secrets/kos-executor.key
#SOLSLOT_PAYMENT_KOS_EXECUTOR_PUBLIC_KEY=0x<48-byte-BLS-public-key>
SOLSLOT_PAYMENT_KOS_EXECUTOR_TIMEOUT_SECONDS=30
# Remote HTTPS execution in staging/production also requires all three paths.
#SOLSLOT_PAYMENT_KOS_EXECUTOR_MTLS_CA_PATH=/run/secrets/kos-ca.pem
#SOLSLOT_PAYMENT_KOS_EXECUTOR_MTLS_CERT_PATH=/run/secrets/kos-client.pem
#SOLSLOT_PAYMENT_KOS_EXECUTOR_MTLS_KEY_PATH=/run/secrets/kos-client.key

# Exact browser origins only in staging/production.
# Same-origin production deployments leave this empty. Development may set
# exact localhost origins together with SOLSLOT_RUNTIME_ENVIRONMENT=development.
SOLSLOT_CORS_ORIGINS=

# Pending enrollment admission; does not expire or recycle exposed bridge coins.
SOLSLOT_ZKPASSPORT_ENROLLMENT_MAX_PENDING_PER_OWNER=3

# Selected Base Sepolia genesis evidence (separate operator-pinned review).
# These are public file references/checksums, never signing credentials.
SOLSLOT_ENROLLMENT_DEPLOYMENT_REVIEW_PATH=
SOLSLOT_ENROLLMENT_DEPLOYMENT_REVIEW_SHA256=
# The existing SOLSLOT_LAUNCH_SOURCE_EVIDENCE_PATH/SHA256 must also be pinned.
