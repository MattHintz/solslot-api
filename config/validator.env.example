# Public signer configuration only. The BLS seed is supplied as a systemd
# credential file and must never be placed in this file.
SOLSLOT_VALIDATOR_SIGNER_INDEX=0
# The systemd unit sets SOLSLOT_VALIDATOR_SEED_FILE through LoadCredential.
SOLSLOT_VALIDATOR_LEDGER_DB_PATH=/var/lib/solslot-validator/signatures_v2.db
SOLSLOT_VALIDATOR_PUBLIC_ARTIFACT_PATH=/var/lib/solslot-validator/public_artifact_v4.json
SOLSLOT_VALIDATOR_RELEASE_METADATA_PATH=/opt/solslot/validator/current/release.json

SOLSLOT_VALIDATOR_NETWORK=testnet11
SOLSLOT_VALIDATOR_COINSET_BASE_URL=https://testnet11.api.coinset.org
SOLSLOT_VALIDATOR_EVM_RPC_URL=https://REPLACE_WITH_REVOKED_PROVIDER_KEY_REPLACEMENT
SOLSLOT_VALIDATOR_EVM_CHAIN_ID=11155111
# Selected permits require ALL of the following after the reviewed deployment:
# SOLSLOT_VALIDATOR_EVM_CHAIN_ID=84532 (replace the legacy line; never duplicate)
# SOLSLOT_VALIDATOR_DEPLOYMENT_ENVIRONMENT=staging-alpha (or production-alpha)
# SOLSLOT_VALIDATOR_ENROLLMENT_ACTIVATION=<compact exact reviewed activation JSON>
# Keep the complete issuer/version/release/context and roster bindings.
# Use scripts/check_validator_fleet.py --enrollment-activation FILE with the
# appropriate artifact expectation; a running systemd service is not health.
SOLSLOT_VALIDATOR_EVM_MIN_CONFIRMATIONS=12
SOLSLOT_VALIDATOR_PROOF_MAX_AGE_SECONDS=604800
SOLSLOT_VALIDATOR_CLAIM_CLOCK_SKEW_SECONDS=90

SOLSLOT_VALIDATOR_BRIDGE_POLICY_HASH=0xREPLACE_AFTER_VALIDATOR_ROSTER_FREEZE
SOLSLOT_VALIDATOR_ROSTER_PUBKEYS=["0x<48-byte-key-0>","0x<48-byte-key-1>","0x<48-byte-key-2>"]
SOLSLOT_VALIDATOR_EVM_FORWARDER_ADDRESS=0xREPLACE_AFTER_SEPOLIA_DEPLOY
SOLSLOT_VALIDATOR_EVM_VERIFIER_ADAPTER_ADDRESS=0xREPLACE_AFTER_SEPOLIA_DEPLOY
SOLSLOT_VALIDATOR_EVM_ATTESTATION_EMITTER_ADDRESS=0xREPLACE_AFTER_SEPOLIA_DEPLOY

# Post-genesis Stripe test-mode evidence. This rail is not a genesis gate and
# stays disabled until the separately approved payment-activation workflow.
# At activation, give each validator a distinct restricted read key with
# Account, Event, PaymentIntent, and Charges read access. Charges read is
# required because evidence verification may GET /v1/charges/{id}.
# The systemd unit sets SOLSLOT_VALIDATOR_STRIPE_RESTRICTED_KEY_FILE through a
# separate LoadCredential=stripe-read-key:... entry; never put the key here.
SOLSLOT_VALIDATOR_STRIPE_SETTLEMENT_ENABLED=false
SOLSLOT_VALIDATOR_STRIPE_ACCOUNT_ID=acct_REPLACE_WITH_TEST_ACCOUNT
SOLSLOT_VALIDATOR_STRIPE_MODE=test
SOLSLOT_VALIDATOR_STRIPE_API_URL=https://api.stripe.com
